# Скопируйте в .env и подставьте свои значения. .env в репозиторий не коммитится.

# --- Прокси (резидентный/мобильный RU-прокси для обхода гео-скоринга ServicePipe) ---
# Единая строка прокси для curl_cffi/requests/httpx:
PROXY_URL=http://user:pass@proxy.example.com:8000

# Либо покомпонентно (используется local_proxy.py как upstream):
PROXY_HOST=proxy.example.com
PROXY_PORT=8000
PROXY_USER=
PROXY_PASS=

# Локальный bridge-прокси (local_proxy.py)
LOCAL_PROXY_HOST=127.0.0.1
LOCAL_PROXY_PORT=8899

# IP ПК/телефона в LAN, на который указывает Wi-Fi proxy телефона (set_proxy_*.py)
PROXY_HOST_LAN=192.168.0.100

# --- Магнит: региональный контекст магазина ---
MAGNIT_SHOP_CODE=000000
MAGNIT_SHOP_TYPE=MM_MINI

# --- Самокат: перехваченные из трафика приложения значения ---
SAMOKAT_JWT=
SAMOKAT_USER_ID=
SAMOKAT_SHOWCASE_ID=
SAMOKAT_HEADERS_FILE=headers.json
